{
  "name": "regenesys-shipment-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --import tsx server/index.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "report": "node --import tsx scripts/report.ts",
    "eval": "node --import tsx scripts/evaluate.ts",
    "lint": "tsc --noEmit",
    "eval:conversations": ".venv-evals/bin/python evals/deepeval_bella.py"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@js-temporal/polyfill": "0.5.1",
    "@supabase/supabase-js": "2.119.0",
    "dotenv": "18.0.9",
    "express": "5.3.0",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
