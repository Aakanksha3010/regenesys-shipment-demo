# Local mode requires no credentials and uses fictional identities and data.
DATA_MODE=local
PORT=4173
# Switch only after creating a dedicated Supabase project and applying the migration.
# DATA_MODE=supabase
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# All keys below are read by the Node server. Only the publishable key is sent to the browser.
